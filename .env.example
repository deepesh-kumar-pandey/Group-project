# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Google AI Studio (Gemini)
GOOGLE_AI_API_KEY="your-google-ai-api-key"

# Geoapify
GEOAPIFY_API_KEY="your-geoapify-api-key"

# Reddit — create app at https://www.reddit.com/prefs/apps
# Required: unique User-Agent (include your Reddit username)
REDDIT_USER_AGENT="review-platform/1.0.0 (by /u/YOUR_REDDIT_USERNAME)"

# OAuth (recommended for production — higher rate limits)
# From Reddit app: client ID (under app name) + secret
REDDIT_CLIENT_ID="your-reddit-client-id"
REDDIT_CLIENT_SECRET="your-reddit-client-secret"

# Script-type apps only: bot/service account credentials
REDDIT_USERNAME="your-reddit-bot-username"
REDDIT_PASSWORD="your-reddit-bot-password"

# Optional Redis (falls back to in-memory cache)
REDIS_URL="redis://localhost:6379"

# App
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
